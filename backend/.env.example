# ========== DATABASE ==========
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/creche"

# ========== NODE ENV ==========
NODE_ENV=development

# ========== AUTH - DEV ONLY ==========
ADMIN_EMAIL=admin@demo.kidcare.app
ADMIN_PASSWORD=change_me
# Démo production — mots de passe des 4 comptes conservés (pnpm run cleanup:demo)
# DEMO_ADMIN_PASSWORD=Sophie123!
# DEMO_TEACHER_PASSWORD=Teacher123!
# DEMO_PARENT_PASSWORD=SophieParent123!
# CLEANUP_ALLOW=true          # requis en NODE_ENV=production pour cleanup:demo
# SHOW_DEMO_CREDENTIALS=false # masquer les mots de passe en fin de script
JWT_SECRET=super_secret_dev_key_change_in_prod
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
REDIS_URL=

# ========== RATE LIMITING ==========
THROTTLE_LIMIT=20
THROTTLE_TTL=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_UPLOAD_LIMIT=15

# ========== CORS ==========
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ========== EMAIL CONFIGURATION ==========
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@kidcare.app
SMTP_PASS=your-smtp-password
SMTP_FROM="KidCare <noreply@kidcare.app>"

# Alternative: Resend API
RESEND_API_KEY=re_xxxxx
SENDER_EMAIL=noreply@kidcare.app

# ========== APP URL ==========
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# ========== OPTIONAL: AI REWRITE WEBHOOK ==========
# N8N_AI_REWRITE_WEBHOOK_URL=https://your-n8n-instance/webhook/kidcare/ai-resume-journee

# ========== PARENT ==========
PARENT_SELF_ADD_CHILD_ENABLED=true

# ========== ÂGE DES ENFANTS ==========
CHILD_MIN_AGE_VALUE=6
CHILD_MIN_AGE_UNIT=months
CHILD_MAX_AGE_VALUE=5
CHILD_MAX_AGE_UNIT=years
