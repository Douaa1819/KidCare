# ========== DATABASE ==========
DATABASE_URL="postgresql://user:password@localhost:5432/creche"

# ========== NODE ENV ==========
NODE_ENV=development

# ========== AUTH - DEV ONLY ==========
# En DEV: utilisé pour /auth/login
# En PROD: utiliser Supabase Auth
ADMIN_EMAIL=admin@wlw.ma
ADMIN_PASSWORD=change_me
JWT_SECRET=super_secret_dev_key_change_in_prod
# Durée access / refresh (ex: 15m, 7d). Rafraîchissement côté client via POST /auth/refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Blacklist JWT révoqués (logout, changement mot de passe). Ex: redis://localhost:6379
REDIS_URL=




# ========== RATE LIMITING ==========
# Nombre de requêtes par minute (IP)
THROTTLE_LIMIT=20
THROTTLE_TTL=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_UPLOAD_LIMIT=15

# ========== CORS ==========
# Origines frontend autorisées (séparées par des virgules, obligatoire en production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ========== EMAIL CONFIGURATION ==========
# SMTP configuration for sending emails (required in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-app-password
SMTP_FROM=noreply@wlw.ma

# Alternative: Resend API (simpler)
RESEND_API_KEY=re_xxxxx
SENDER_EMAIL=noreply@wlw.ma

# ========== APP URL ==========
# Used in email links
APP_URL=https://creche-saas.vercel.app
# URL du frontend (liens e-mail mot de passe oublié)
FRONTEND_URL=http://localhost:3001

# ========== PARENT ==========
# Permet au tuteur principal d’ajouter un enfant depuis l’espace parent (avec classe)
PARENT_SELF_ADD_CHILD_ENABLED=true

# ========== ÂGE DES ENFANTS ==========
# Minimum : valeur + unité (months | years) — ex. 6 mois ou 1 an
CHILD_MIN_AGE_VALUE=6
CHILD_MIN_AGE_UNIT=months
# Maximum : ex. 5 ans (un enfant de 10 ans sera refusé)
CHILD_MAX_AGE_VALUE=5
CHILD_MAX_AGE_UNIT=years

