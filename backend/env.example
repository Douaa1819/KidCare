DATABASE_URL="postgresql://..."

# Origines autorisées (CORS), séparées par des virgules — inclure l’URL du frontend (ex. Vercel).
# CORS_ORIGINS=https://www.thepetitspas.com,https://thepetitspas.com,http://localhost:3001

# URL publique du site (liens dans les emails)
APP_URL=https://www.thepetitspas.com
FRONTEND_URL=https://www.thepetitspas.com

# SMTP (emails inscription / identifiants parent)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@thepetitspas.com
SMTP_PASS=your-smtp-password
SMTP_FROM="PetitsPas <noreply@thepetitspas.com>"

# Photos d’activités : stockées en base (BYTEA). Après déploiement : `pnpm prisma migrate deploy`.
