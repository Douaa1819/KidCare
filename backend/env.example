DATABASE_URL="postgresql://..."

# Origines autorisées (CORS), séparées par des virgules — inclure l’URL du frontend.
# CORS_ORIGINS=https://kidcare.app,https://www.kidcare.app,http://localhost:3001

# URL publique du site (liens dans les emails)
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# SMTP (emails inscription / identifiants parent)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@kidcare.app
SMTP_PASS=your-smtp-password
SMTP_FROM="KidCare <noreply@kidcare.app>"

# Webhook n8n optionnel pour la réécriture IA des résumés de journée
# N8N_AI_REWRITE_WEBHOOK_URL=https://your-n8n-instance/webhook/kidcare/ai-resume-journee

# Photos d’activités : stockées en base (BYTEA). Après déploiement : `pnpm prisma migrate deploy`.
